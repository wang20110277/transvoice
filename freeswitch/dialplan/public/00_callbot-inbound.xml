<document type="freeswitch/xml">
  <section name="dialplan">
    <context name="public">

      <!--
        catch-all 呼入拨号计划。
        三元组 (tenant_id, biz_type, scenario) 不在 dialplan 硬编码 —— 由 agent-flow
        在 CHANNEL_ANSWER 读 Caller-Destination-Number(=DID)后查 callbot.inbound_route 表解析。
        新增/修改 DID 路由在 Console「DID 路由」页运营,无需改本文件、无需重启 FS。
      -->
      <extension name="callbot-inbound">
        <condition field="destination_number" expression="^(\d+)$">
          <action application="set" data="call_start_time=${strftime(%Y-%m-%d %H:%M:%S)}"/>
          <!-- user_key: 呼入为主叫手机号;呼出时由 originate 设为客户手机号 -->
          <action application="set" data="user_key=${caller_id_number}"/>
          <action application="answer"/>
          <!-- 录音提示音（合规）。本地测试或 wav 不存在时注释此行；缺失文件 FS 仅记日志不影响通话 -->
          <!-- <action application="playback" data="ivr/recording_notice.wav"/> -->
          <!-- 整通录音由 FreeSWITCH uuid_record 录制双声道（L=caller / R=AI TTS）—— agent-flow 在
               audio_fork_start 之后发起 uuid_record（record bug 排在 mod_audio_fork WRITE_REPLACE 之后，
               方能录到 dub 后的 AI 下行）。dialplan 不用 record_session（会抢在 audio_fork 前注册，录不到
               AI），仅 playback silence_stream://-1 保活。挂断后 agent-flow 读此目录 wav 上传 MinIO -->
          <action application="playback" data="silence_stream://-1"/>
        </condition>
      </extension>

    </context>
  </section>
</document>
