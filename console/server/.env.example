# ── 数据库(与 agent-flow 同库同表) ──
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/callbot

# ── Redis(与 agent-flow 同实例) ──
REDIS_URL=redis://127.0.0.1:6379/0

# ── Better Auth ──
BETTER_AUTH_SECRET=change-me-32-chars-min
BETTER_AUTH_URL=http://localhost:3001

# ── 联调 LLM(ollama OpenAI 兼容端点) ──
CONSOLE_LLM_BASE_URL=http://127.0.0.1:11434/v1
CONSOLE_LLM_MODEL=qwen3:4b-instruct
CONSOLE_LLM_API_KEY=ollama

# ── ADFS OAuth(企业内网;本地开发关闭) ──
CONSOLE_ADFS_ENABLED=false
